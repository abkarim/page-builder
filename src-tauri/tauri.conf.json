{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pagebuilder",
  "version": "./../package.json",
  "identifier": "com.karim.pagebuilder",
  "build": {
    "beforeDevCommand": "npm run dev & npx esbuild ./resources/editor-assets/js/editor.ts --outfile=./resources/editor-assets/js/editor.js --bundle --watch --format=iife --target=esnext --minify",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Page Builder",
        "width": 800,
        "height": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Drag and Drop page builder",
    "longDescription": "Create interactive page using drag and drop page builder",
    "resources": [
      "./../block-templates",
      "./../component-templates",
      "./../resources/"
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}